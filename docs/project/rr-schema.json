{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://king-of-the-ai-jungle.dev/schemas/rn-rules",
  "title": "R&R Cycle Rules Schema",
  "description": "Machine-readable schema for validating R&R-CYCLE-RULES.md compliance.",
  "type": "object",
  "required": ["meta", "sections", "rules"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "lastUpdated", "documentPath"],
      "properties": {
        "version": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
        "lastUpdated": { "type": "string", "format": "date" },
        "documentPath": { "type": "string" },
        "totalSections": { "type": "integer" },
        "totalRules": { "type": "integer" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "lastVerified"],
        "properties": {
          "id": { "type": "string", "description": "Short identifier, e.g. 'SECURITY', 'PEDAGOGY'." },
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "titleEmoji": { "type": "string" },
          "description": { "type": "string" },
          "lastVerified": { "type": "string" },
          "domains": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rules": { "type": "array" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "title", "section", "severity"],
        "properties": {
          "code": { "type": "string", "description": "Rule code, e.g. 'FRS-1', 'PW-3', 'RR-1'." },
          "title": { "type": "string" },
          "section": { "type": "integer", "description": "Section number this rule belongs to." },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "sourceCycle": { "type": "string" },
          "lastVerified": { "type": "string" },
          "verifiedBy": { "type": "array", "items": { "type": "integer" } },
          "status": {
            "type": "string",
            "enum": ["Implemented", "Preventive", "Pending Validation"]
          },
          "verificationMethod": {
            "type": "string",
            "enum": ["manual", "script", "ci-pipeline", "checklist"]
          },
          "checkCommand": { "type": "string", "description": "Shell command or script to verify this rule." },
          "jungleTitles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
